{
  "expo": {
  "name": "RivalSet",
    "slug": "temp-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo.png",
    "scheme": "rivalset",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/Logo.png",
      "bundleIdentifier": "com.javiercepeda29.rivalset",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-splash-screen",
        {
        "backgroundColor": "#08090C",
        "image": "./assets/images/Logo.png",
        "imageWidth": 150
        }
      ],
      "expo-web-browser",
      [
  "expo-image-picker",
  {
    "photosPermission": "RivalSet necesita acceso a tus fotos para analizar comidas.",
    "cameraPermission": "RivalSet necesita acceso a la cámara para fotografiar y analizar comidas.",
    "microphonePermission": false
  }
],
[
  "react-native-google-mobile-ads",
  {
    "iosAppId": "ca-app-pub-8331221306002333~4274844356"
  }
]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "4be49330-2380-419a-a8be-614e0e03d201"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4be49330-2380-419a-a8be-614e0e03d201"
    }
  }
}
